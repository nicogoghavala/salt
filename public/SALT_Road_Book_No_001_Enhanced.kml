    <Placemark>
      <name>Salt Road Book No. 001 — Village Route</name>
      <styleUrl>#line-FF0066-4000-nodesc</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          72.8347,18.9067,0
          73.0297,18.99,0
          73.0833,18.85,0
          73.1989,18.65,0
          73.12,18.44,0
          73.1396,18.2915,0
          73.3045,18.3185,0
          73.25,18.4333,0
          73.3167,18.4167,0
          73.45,18.25,0
          73.4833,17.9833,0
